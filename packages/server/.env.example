PORT=3001
HOST=0.0.0.0
# Production domains only — no wildcards (wildcard + credentials is rejected by browsers).
CORS_ORIGIN=https://belote1.netlify.app

# Supabase — required for JWT verification of socket connections and for
# server-authoritative match/tournament persistence (service role bypasses RLS).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt
# Optional but strongly recommended: enables local JWT verification (no network round-trip).
# Find it in: Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret
